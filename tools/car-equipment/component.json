{
  "id": "bmrmodz-car-equipment",
  "kind": "tool",
  "version": "0.1.3",
  "title": "Car Equipment",
  "description": "Shared MGU read-only vehicle option cache. One VO read when no cache exists; subsequent checks use /var/opt cache, explicit reload rescans. Healthy service startup does not require diagnostic helper to be immediately available.",
  "optional": true,
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "iteriodev-comfort": "0.6.3",
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "service.js",
      "from": "service.js",
      "mode": "0644"
    },
    {
      "path": "vehicle-order.js",
      "from": "vehicle-order.js",
      "mode": "0644"
    },
    {
      "path": "equipment.js",
      "from": "equipment.js",
      "mode": "0644"
    },
    {
      "path": "transport.js",
      "from": "transport.js",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bmrmodz-car-equipment.service",
      "from": "bmrmodz-car-equipment.service"
    }
  ],
  "enable": [
    {
      "unit": "bmrmodz-car-equipment.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "bmrmodz-car-equipment.service"
  ],
  "recmgr": [
    "bmrmodz-car-equipment"
  ]
}
