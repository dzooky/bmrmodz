{
  "id": "bmrmodz-car-equipment",
  "kind": "tool",
  "version": "0.1.0",
  "title": "Car Equipment",
  "description": "Shared read-only BMW MGU iDrive 7 vehicle-equipment detection for BMRMODZ OSA, DPF Monitor and other apps. Reads FA/VO using the same decoder and gateway query as Climate Comfort; caches SA codes and serves local yes/no/unknown checks. Uses TASU via hmictl supplied by the separately installed IterioDev Comfort HU Tool. Vehicle validation pending.",
  "optional": true,
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "iteriodev-comfort": "0.6.3",
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "service.js",
      "from": "service.js",
      "mode": "0644"
    },
    {
      "path": "vehicle-order.js",
      "from": "vehicle-order.js",
      "mode": "0644"
    },
    {
      "path": "equipment.js",
      "from": "equipment.js",
      "mode": "0644"
    },
    {
      "path": "transport.js",
      "from": "transport.js",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bmrmodz-car-equipment.service",
      "from": "bmrmodz-car-equipment.service"
    }
  ],
  "enable": [
    {
      "unit": "bmrmodz-car-equipment.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "bmrmodz-car-equipment.service"
  ]
}
